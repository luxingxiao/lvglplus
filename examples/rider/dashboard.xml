<dashboard version="1">
  <inputs><key action="up" command="up"/><key action="down" command="down"/><key action="confirm" command="confirm"/><key action="back" command="back"/><key action="right" command="next"/></inputs>
  <styles><style name="muted" color="#8b9da8"/><style name="button" bg="#142c2b" color="#6ee7b7" radius="6" padding="6"/></styles>
  <page id="instrument" bg="#070d10" color="#edf4ff" font="labels">
    <text id="brand" x="20" y="15" text="LVGL PLUS / RIDER" fontSize="20" color="#edf4ff"/>
    <text id="ready" x="335" y="15" text="READY" color="#6ee7b7" fontSize="20"/>
    <text id="clock" x="720" y="15" width="110" fontSize="20" color="#edf4ff"><bind property="text" expression="floor(sim.ms/1000)" format="%d s"/></text>
    <panel id="core" x="20" y="60" width="520" height="350" bg="#0b141c" radius="8">
      <grid id="grid" x="15" y="15" width="490" height="130" gridX="30" gridY="20" color="#20313a" lineWidth="1"/>
      <path id="trend" x="15" y="15" width="490" height="130" color="#14cab4" curve="catmull-rom" points="0,70 70,55 140,85 210,60 280,55 350,80 420,60 485,65">
        <bind property="p2y" expression="70+20*sin(sim.ms/1000)"/><bind property="p4y" expression="70+25*cos(sim.ms/1700)"/>
      </path>
      <text id="speed" x="150" y="145" width="280" font="digits" color="#edf4ff"><bind property="text" signal="speed" format="%.0f"/></text>
      <text id="unit" x="225" y="270" text="MPH" fontSize="20" style="muted"/>
      <text id="battery" x="20" y="310" fontSize="20" color="#edf4ff"><bind property="text" signal="battery" format="BAT %.0f%%"/></text>
      <bar id="charge" x="185" y="315" width="180" height="12" color="#6ee7b7"><bind property="value" signal="battery"/></bar>
    </panel>
    <panel id="home" x="555" y="65" width="270" height="340" bg="#102027" padding="15" radius="8">
      <bind property="hidden" expression="state.screen!=0"/>
      <text id="homeTitle" text="车友雷达 / 组队骑行" color="#edf4ff"/>
      <text id="homeCopy" y="45" text="XML + Model + shared C VM" fontSize="14" color="#edf4ff"/>
      <button id="radarButton" y="90" width="230" height="48" text="车友雷达" style="button"><on event="click" command="openRadar"/></button>
      <button id="teamButton" y="155" width="230" height="48" text="组队骑行" style="button"><on event="click" command="openTeam"/></button>
      <text id="instructions" y="230" text="Right: next screen" fontSize="14" color="#edf4ff"/>
    </panel>
    <panel id="radar" x="0" y="45" width="840" height="370" bg="#071512" clip="true">
      <bind property="hidden" expression="state.screen!=1"/>
      <grid id="radarGrid" x="0" y="0" width="840" height="370" gridX="40" gridY="40" color="#12342d" lineWidth="1"/>
      <sector id="beam" x="205" y="-25" width="370" height="370" pivotX="185" pivotY="185" bg="#087f5b" startAngle="0" endAngle="42" fade="true" opacity="180"><bind property="rotation" expression="scan.ms*0.06"/></sector>
      <text id="radarTitle" x="20" y="15" text="车友雷达" color="#6ee7b7"/>
      <repeat collection="observed">
        <panel id="marker" width="42" height="42" bg="#12392f" radius="21" border="2" borderColor="#6ee7b7">
          <bind property="x" expression="${item.x}-21"/><bind property="y" expression="${item.y}-21"/>
          <bind property="hidden" expression="observed.sequence==0 || ${index}&gt;=candidateCount"/>
          <text id="name" x="10" y="10" text="${index}" fontSize="20" color="#edf4ff"/>
        </panel>
      </repeat>
      <text id="selected" x="20" y="325" fontSize="20" color="#edf4ff"><bind property="text" signal="selected" format="Selected: %d"/></text>
      <text id="greetings" x="250" y="325" fontSize="20" color="#edf4ff"><bind property="text" signal="greetings" format="Greetings: %d"/></text>
      <button id="scanToggle" x="645" y="10" width="160" height="38" text="扫描" style="button"><on event="click" command="scanToggle"/></button>
    </panel>
    <panel id="teamMap" x="550" y="45" width="280" height="370" bg="#08191c" clip="true">
      <bind property="hidden" expression="state.screen!=2"/>
      <grid id="mapGrid" width="280" height="370" gridX="24" gridY="24" color="#17353b" lineWidth="1"/>
      <panel id="mapContent" width="280" height="370" pivotX="140" pivotY="185" bgOpacity="0">
        <bind property="scaleX" expression="zoom*256"/><bind property="scaleY" expression="zoom*256"/>
      <path id="route" width="280" height="370" color="#32e2bb" lineWidth="4" dashLength="10" dashGap="5" curve="catmull-rom" points="10,365 45,310 140,260 100,180 210,85 245,30"/>
      <repeat collection="projected">
        <panel id="member" width="30" height="30" bg="#0b3436" radius="15" border="1" borderColor="#6ee7b7">
          <bind property="x" expression="clusterX(projected,${index},34)"/>
          <bind property="y" expression="clusterY(projected,${index},34)"/>
          <bind property="hidden" expression="peers.sequence==0 || clusterId(projected,${index},34)!=${index}"/>
          <text id="count" x="8" y="4" fontSize="14" color="#edf4ff"><bind property="text" expression="clusterSize(projected,${index},34)" format="%d"/></text>
        </panel>
      </repeat>
      <polygon id="heading" x="125" y="275" width="24" height="30" points="12,0 22,28 12,20 2,28" bg="#6ee7b7" color="#6ee7b7" pivotX="12" pivotY="15"><bind property="rotation" expression="role*30 + 10*sin(sim.ms/1500)"/></polygon>
      </panel>
      <text id="teamTitle" x="10" y="10" text="组队骑行" color="#edf4ff"/>
      <text id="snapshot" x="10" y="340" fontSize="14" color="#edf4ff"><bind property="text" signal="peers.sequence" format="Snapshot #%d / 0.5 Hz"/></text>
    </panel>
    <panel id="teamInfo" x="25" y="350" width="505" height="57" bg="#10272b" padding="8">
      <bind property="hidden" expression="state.screen!=2"/>
      <text id="role" fontSize="14" color="#edf4ff"><bind property="text" signal="role" format="Role %d / 3"/></text>
      <text id="phase" x="150" fontSize="14" color="#edf4ff"><bind property="text" signal="phase" format="Phase %d / 8"/></text>
      <text id="messages" x="305" fontSize="14" color="#edf4ff"><bind property="text" signal="messages" format="Messages %d"/></text>
    </panel>
    <button id="send0" x="20" y="416" width="80" height="26" text="OK" fontSize="14" style="button"><on event="click" command="send" argument="0"/></button>
    <button id="send1" x="106" y="416" width="80" height="26" text="Stop" fontSize="14" style="button"><on event="click" command="send" argument="1"/></button>
    <button id="send2" x="192" y="416" width="80" height="26" text="Lost" fontSize="14" style="button"><on event="click" command="send" argument="2"/></button>
    <button id="send3" x="278" y="416" width="80" height="26" text="Follow" fontSize="14" style="button"><on event="click" command="send" argument="3"/></button>
    <button id="send4" x="364" y="416" width="80" height="26" text="POI" fontSize="14" style="button"><on event="click" command="send" argument="4"/></button>
    <button id="send5" x="450" y="416" width="80" height="26" text="Captain" fontSize="14" style="button"><on event="click" command="send" argument="5"/></button>
    <button id="next" x="20" y="450" width="150" height="25" text="Screen" fontSize="14" style="button"><on event="click" command="next"/></button>
    <button id="pause" x="182" y="450" width="150" height="25" text="Pause" fontSize="14" style="button"><on event="click" command="pause"/></button>
    <button id="rate" x="344" y="450" width="150" height="25" text="1x/2x" fontSize="14" style="button"><on event="click" command="rate"/></button>
    <button id="roleButton" x="506" y="450" width="150" height="25" text="Role" fontSize="14" style="button"><on event="click" command="role"/></button>
    <button id="phaseButton" x="668" y="450" width="150" height="25" text="Phase" fontSize="14" style="button"><on event="click" command="phase"/></button>
  </page>
</dashboard>
